# Pengui ortam değişkenleri (örnek)
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.

# Bakım modu: "true" iken tüm trafik /maintenance'a yönlenir.
MAINTENANCE_MODE=false

# /preview sayfasında bakım modunu aşmak için kullanılan parola.
MAINTENANCE_PASSWORD=supersecret

# (Opsiyonel) Plausible analytics alan adı; tanımlıysa script eklenir.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=pengui.org
